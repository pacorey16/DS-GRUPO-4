library(tidyverse)
library(broom)
library(car)
library(lmtest)
listings_4_2 <- read.csv("./csv/listings_preprocesado.csv")
# Modelo explicativo base
modelo_precio <- glm(price ~ neighbourhood_cleansed +
room_type +
accommodates +
bathrooms +
has_pool +
has_ac +
review_scores_rating,
family = Gamma(link = "log"),
data = listings_4_2)
summary(modelo_precio)
# A. Multicolinealidad (VIF)
# Verificamos que las variables no sean redundantes entre sí
vif_valores <- vif(modelo_precio)
print("--- Valores VIF (Deben ser < 5) ---")
print(vif_valores)
par(mar = c(5, 8, 4, 2)) # Ajustar márgenes
barplot(vif_valores, main = "Validación: Factor de Inflación de la Varianza (VIF)",
horiz = TRUE, col = "steelblue", xlim = c(0, 5), las = 1)
abline(v = 5, col = "red", lty = 2)
# B. Heterocedasticidad (Breusch-Pagan)
# Comprobamos si el error es constante
print("--- Test de Breusch-Pagan ---")
bptest(modelo_precio)
coeficientes <- tidy(modelo_precio) %>%
filter(term != "(Intercept)") %>%
filter(!str_detect(term, "neighbourhood")) %>%
mutate(impacto_pct = (exp(estimate) - 1) * 100) %>%
arrange(desc(impacto_pct))
ggplot(coeficientes, aes(x = reorder(term, impacto_pct), y = impacto_pct, fill = impacto_pct > 0)) +
geom_bar(stat = "identity") +
coord_flip() +
theme_minimal() +
scale_fill_manual(values = c("tomato", "lightseagreen")) + # Colores más académicos
labs(title = "¿Cuánto valen las características de un piso en Sevilla?",
subtitle = "Incremento porcentual sobre el precio base (%)",
x = "Atributo", y = "Variación Porcentual (%)", fill = "Aporta Valor")
# Calculamos predicciones y residuos
listings_4_2$precio_justo <- predict(modelo_precio, listings_4_2, type = "response")
listings_4_2$sobreprecio <- listings_4_2$price - listings_4_2$precio_justo
# A. Gráfico Radar (Scatter Plot)
ggplot(listings_4_2, aes(x = precio_justo, y = price)) +
geom_point(alpha = 0.3, color = "gray50") +
geom_abline(intercept = 0, slope = 1, color = "red", linetype = "dashed", size = 1) +
annotate("text", x = 100, y = 450, label = "Sobrevalorados\n(Trampas)", color = "red", fontface="bold") +
annotate("text", x = 400, y = 100, label = "Infravalorados\n(Oportunidades)", color = "darkgreen", fontface="bold") +
theme_minimal() +
labs(title = "Radar de Mercado: Precio Real vs. Precio Justo",
x = "Precio Estimado por el Modelo (€)", y = "Precio Real (€)") +
xlim(0, 500) + ylim(0, 500)
# B. Tablas de Casos Extremos
top_inflados <- listings_4_2 %>%
arrange(desc(sobreprecio)) %>%
select(id, neighbourhood_cleansed, price, precio_justo, sobreprecio) %>%
head(10)
top_chollos <- listings_4_2 %>%
arrange(sobreprecio) %>%
select(id, neighbourhood_cleansed, price, precio_justo, sobreprecio) %>%
head(10)
print("--- Top 10 Trampas Turísticas ---")
print(top_inflados)
print("--- Top 10 Oportunidades ---")
print(top_chollos)
modelo_interaccion <- glm(price ~ neighbourhood_cleansed +
accommodates +
review_scores_rating +
has_pool * room_type, # Interacción Clave
family = Gamma(link = "log"),
data = listings_4_2)
print("--- Resultados del Modelo con Interacción (GLM) ---")
coef_interaccion <- summary(modelo_interaccion)$coefficients
coef_interaccion[grep("pool", row.names(coef_interaccion)), ]
# Calculamos el precio medio según si tiene piscina y el tipo de alojamiento
interaccion_plot <- listings_4_2 %>%
group_by(room_type, has_pool) %>%
summarise(precio_medio = mean(price), .groups = 'drop') %>%
mutate(has_pool = factor(has_pool, labels = c("Sin Piscina", "Con Piscina")))
ggplot(interaccion_plot, aes(x = room_type, y = precio_medio, group = has_pool, color = has_pool)) +
geom_line(size = 1.2) +
geom_point(size = 3) +
theme_minimal() +
scale_color_manual(values = c("tomato", "lightseagreen")) + # Colores coherentes
labs(title = "¿Vale la pena poner piscina?",
subtitle = "La revalorización depende drásticamente de la tipología del activo",
x = "Tipo de Alojamiento", y = "Precio Medio Bruto (€)", color = "")
predecir_precio <- function(barrio, tipo, capacidad, baños, piscina, ac, rating) {
nuevo_piso <- data.frame(
neighbourhood_cleansed = barrio,
room_type = tipo,
accommodates = capacidad,
bathrooms = baños,
has_pool = piscina, # 1 o 0
has_ac = ac,        # 1 o 0
review_scores_rating = rating
)
prediccion <- predict(modelo_precio, newdata = nuevo_piso, type = "response")
return(paste0("El precio justo de mercado para este piso es: ", round(prediccion, 2), "€"))
}
# "¿Cuánto debería cobrar por un piso en Triana para 4 personas con piscina?"
print(predecir_precio("Triana Oeste", "Entire home/apt", 4, 1, 1, 1, 4.8))
# --- Visualización "Diana" del Efecto Giralda ---
library(dplyr)
library(ggplot2)
library(geosphere) # Necesario para calcular la distancia
# 1. Definimos el centro (Giralda)
centro_giralda <- c(-5.99238, 37.38614)
# 2. CALCULAMOS LA DISTANCIA (El paso que faltaba antes)
df_eda <- df_eda %>%
rowwise() %>%
mutate(
distancia_giralda_m = distHaversine(c(longitude, latitude), centro_giralda)
) %>%
ungroup()
# 3. Ahora sí, creamos df_diana filtrando por esa distancia
df_diana <- df_eda %>%
filter(distancia_giralda_m <= 3000)
# 4. Generamos los anillos de la diana (1km, 2km, 3km)
crear_anillo <- function(radio_metros, etiqueta) {
angulos <- seq(0, 2*pi, length.out = 100)
r_lat <- radio_metros / 111132.95
r_lon <- radio_metros / (111132.95 * cos(centro_giralda[2] * pi/180))
data.frame(
x = centro_giralda[1] + r_lon * cos(angulos),
y = centro_giralda[2] + r_lat * sin(angulos),
label = etiqueta
)
}
anillos <- bind_rows(
crear_anillo(500, "500 m"),
crear_anillo(1000, "1 km"),
crear_anillo(1500, "1.5 km"),
crear_anillo(2000, "2 km"),
crear_anillo(2500, "2.5 km"),
crear_anillo(3000, "3 km")
)
# 5. Pintamos el Mapa
ggplot() +
geom_point(data = df_diana, aes(x = longitude, y = latitude, color = price),
size = 1, alpha = 0.8) +
geom_path(data = anillos, aes(x = x, y = y), color = "white", linetype = "dashed", size = 0.8) +
geom_text(data = anillos %>% group_by(label) %>% slice(1),
aes(x = x, y = y, label = label), color = "white", vjust = -0.5, fontface = "bold") +
annotate("point", x = centro_giralda[1], y = centro_giralda[2], color = "yellow", size = 4, shape = 18) +
annotate("text", x = centro_giralda[1], y = centro_giralda[2], label = "Giralda",
vjust = 2, color = "yellow", fontface = "bold", size = 4) +
scale_color_viridis_c(option = "magma", direction = -1, limits = c(0, 300), oob = scales::squish) +
coord_quickmap() +
theme_void() +
theme(plot.background = element_rect(fill = "gray10", color = NA),
legend.text = element_text(color = "white"),
legend.title = element_text(color = "white"),
plot.title = element_text(color = "white", hjust = 0.5)) +
labs(title = "Mapa de Calor Radial: El 'Efecto Giralda'",
subtitle = "Decaimiento del precio en anillos de 1km, 2km y 3km",
color = "Precio (€)")
# 1. Filtramos datos para comparar "manzanas con manzanas"
df_giralda <- df_eda %>%
filter(
room_type == "Entire home/apt", # Solo pisos completos
price < 400,                    # Filtramos lujo extremo para ver la tendencia general
distancia_giralda_m <= 3000     # Analizamos solo los primeros 3 kilómetros
)
# 2. Visualización del Modelo LOESS
ggplot(df_giralda, aes(x = distancia_giralda_m, y = price)) +
geom_point(alpha = 0.15, color = "darkmagenta") +
# Añadimos la curva LOESS para ver la tendencia no lineal
geom_smooth(method = "loess", color = "red", linewidth = 1.5, span = 0.5) +
theme_minimal() +
labs(
title = "El Efecto Giralda: Decaimiento del Precio Turístico",
subtitle = "La curva roja (LOESS) muestra cómo el precio se desploma en el primer kilómetro y luego se estabiliza",
x = "Distancia a la Giralda (metros)",
y = "Precio por Noche (€)"
)
# 3. Modelo Matemático (Regresión Lineal) para el primer kilómetro
# Queremos saber el dato exacto de cuánto cae por cada 100 metros en la zona más sensible
df_primer_km <- df_giralda %>% filter(distancia_giralda_m <= 1000)
modelo_lineal <- lm(price ~ distancia_giralda_m, data = df_primer_km)
# Extraemos el coeficiente (cuánto cae el precio por cada 1 metro) y lo multiplicamos por 100
caida_por_metro <- coef(modelo_lineal)["distancia_giralda_m"]
caida_por_100m <- caida_por_metro * 100
print(paste("Caída del precio por cada 100 metros en el primer kilómetro:", round(caida_por_100m, 2), "€"))
